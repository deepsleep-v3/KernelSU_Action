# ================= 基础信息 =================
KERNEL_SOURCE=https://github.com/PixelExperience-Devices/kernel_xiaomi_vangogh
KERNEL_SOURCE_BRANCH=thirteen
KERNEL_CONFIG=vangogh_user_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=vangogh

# ================= 编译工具链 =================
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ================= 【核心救命】防汇编器报错与错乱 =================
# 用 gnu 骗过内核检查，用 LLVM_IAS=1 强行让 Clang 自己汇编，彻底避开系统 as 的 -EL 报错
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu- LLVM_IAS=1 HOSTCC=gcc HOSTCXX=g++
EXTRA_CMDS=LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes

# ================= 你的执念：SukiSU-Ultra =================
# 换成 SukiSU-Ultra 的 builtin 分支（唯一自带 SUSFS 且支持老内核的分支）
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=auto
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ================= SUSFS 隐藏 =================
# 因为 builtin 已经自带了 SUSFS，这里必须设 false，防止脚本重复打补丁引发冲突！
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ================= 补丁与其他 =================
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================= Kconfig =================
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ================= AnyKernel3 =================
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================= Runner =================
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
